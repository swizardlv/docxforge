# Copy to .env.local to override.

# Force the in-browser mock API (no backend needed).
# When unset, the app probes GET /api/health once at startup and falls back to
# the mock adapter automatically if the backend is unreachable.
VITE_USE_MOCK_API=0

# API base path. Keep "/api" so the dev-server proxy (5173 -> 8000) applies.
VITE_API_BASE=/api
